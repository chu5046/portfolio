---
const educationList = [
  {
    period: '2023.03 - 2025.08',
    school: '경북대학교',
    major: '심화컴퓨터공학과',
    degree: '학사(편입)',
    details: ['GPA: 3.43 / 4.5', 'ABEEK수료', '우수 논문상 동상'],
  },

];
---

<!-- 밝은 테마 학력 섹션 -->
<section id="education">
  <div class="section-header">
    <span class="section-label">Education</span>
    <h2 class="section-title">학력</h2>
  </div>
  
  <div class="education-list">
    {educationList.map((edu, index) => (
      <div class="education-item">
        <div class="item-number">{String(index + 1).padStart(2, '0')}</div>
        <div class="item-content">
          <div class="item-header">
            <div>
              <h3 class="school">{edu.school}</h3>
              <p class="major">{edu.major} · {edu.degree}</p>
            </div>
            <span class="period">{edu.period}</span>
          </div>
          <div class="details">
            {edu.details.map((detail) => (
              <span class="detail-tag">{detail}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="education-footer"> </div>
</section>

<style>
  .section-header {
    margin-top: 5rem;
    margin-bottom: 10rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .education-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.75rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    transition: all 0.2s ease;
  }

  .education-item:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow);
  }

  .item-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    opacity: 0.3;
    line-height: 1;
  }

  .item-content {
    flex: 1;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .school {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--foreground);
    margin-bottom: 0.25rem;
  }

  .major {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .period {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    background: var(--background-secondary);
    padding: 0.375rem 0.875rem;
    border-radius: 20px;
    white-space: nowrap;
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .detail-tag {
    padding: 0.375rem 0.875rem;
    background: rgba(37, 99, 235, 0.08);
    color: var(--primary);
    font-size: 0.8125rem;
    border-radius: 6px;
    font-weight: 500;
  }
  .education-footer{
    margin-bottom: 10rem;
  }

  @media (max-width: 768px) {
    .education-item {
      flex-direction: column;
      gap: 0.5rem;
    }

    .item-header {
      flex-direction: column;
      gap: 0.5rem;
    }

    .item-number {
      font-size: 1.25rem;
    }
  }

</style>
