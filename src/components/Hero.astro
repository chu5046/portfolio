        <div class="avatar">
          <img src="/images/profile.png" alt="프로필 사진" />
        </div>
        <div class="avatar-decoration">
          <div class="decoration-ring"></div>
        </div>
      </div>
      
      <!-- 플로팅 카드들 -->
