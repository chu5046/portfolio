</section>

<style>
  .yujuo {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7rem 2rem 4rem;
    position: relative;
    overflow: hidden;
  }

  /* 배경 장식 */
  .yujuo-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .bg-gradient {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.08) 0%, transparent 70%);
    border-radius: 50%;
  }

  .bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(37, 99, 235, 0.1) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.5;
  }

  .yujuo-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    position: relative;
    z-index: 1;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--success);
    margin-bottom: 1.5rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--success);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.9); }
  }

  .name {
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--foreground);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .highlight {
    background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.5px;
  }

  .description {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    max-width: 480px;
  }

  .description strong {
    color: var(--foreground);
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 2rem;
  }

  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--background-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground-secondary);
    transition: all 0.2s ease;
  }

  .tech-badge:hover {
    border-color: var(--primary);
    background: rgba(37, 99, 235, 0.05);
  }

  .tech-badge svg {
    color: var(--primary);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 10px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);
  }

  .btn-primary:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.3);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: var(--background);
    border: 1px solid var(--border);
    color: var(--foreground);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(37, 99, 235, 0.05);
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--background-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--muted);
    transition: all 0.2s ease;
  }

  .social-icon:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--primary-foreground);
    transform: translateY(-2px);
  }

  /* 프로필 비주얼 */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .avatar-wrapper {
    position: relative;
    width: 360px;
    height: 360px;
  }

  .avatar-glow {
    position: absolute;
    inset: -20px;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.2) 0%, rgba(14, 165, 233, 0.2) 100%);
    border-radius: 50%;
    filter: blur(40px);
  }

  .avatar {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
    background: var(--background-secondary);
    border: 4px solid var(--background);
    box-shadow: var(--shadow-lg);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-decoration {
    position: absolute;
    inset: -20px;
    pointer-events: none;
  }

  .decoration-ring {
    position: absolute;
    inset: 0;
    border: 2px dashed var(--border);
    border-radius: 50%;
    animation: spin 40s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* 플로팅 카드 */
  .floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    box-shadow: var(--shadow);
    animation: floatCard 6s infinite ease-in-out;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(37, 99, 235, 0.1);
    border-radius: 8px;
    color: var(--primary);
  }

  .card-1 {
    top: 5%;
    right: -5%;
    animation-delay: 0s;
  }

  .card-2 {
    bottom: 30%;
    left: -10%;
    animation-delay: -2s;
  }

  .card-3 {
    bottom: 5%;
    right: 5%;
    animation-delay: -4s;
  }

  @keyframes floatCard {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  /* 스크롤 힌트 */
  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .scroll-hint svg {
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* 반응형 */
  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }

    .hero-text {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .name {
      font-size: 2.75rem;
    }

    .description {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
    }

    .social-links {
      justify-content: center;
    }

    .hero-visual {
      order: -1;
    }

    .avatar-wrapper {
      width: 280px;
      height: 280px;
    }

    .floating-card {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 6rem 1rem 3rem;
    }

    .name {
      font-size: 2rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary,
    .btn-secondary {
      justify-content: center;
      width: 100%;
    }

    .scroll-hint {
      display: none;
    }
  }
</style>
