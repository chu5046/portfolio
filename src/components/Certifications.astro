---
const certifications = [
  { name: '정보처리기사', date: '2025.12', issuer: '한국산업인력공단' },
  { name: '컴퓨터활용능력2급', date: '2025.09', issuer: '대한상공회의소' },
  { name: '2종보통운전면허', date: '2022.05', issuer: '경찰청(운전면허시험관리단)' },
];

const languages = [
  { name: 'TOEIC', score: '905점', date: '2025.04' },
];
---

<!-- 밝은 테마 자격증 섹션 -->
<section id="certifications" class="cert-section">
  <div class="section-top"> </div>
  <div class="section-header">
    <span class="section-label">Qualifications</span>
    <h2 class="section-title">자격증 및 어학</h2>
  </div>
  
  <div class="cert-grid">
    <div class="cert-category">
      <div class="category-header">
        <div class="category-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
        </div>
        <h3 class="category-title">자격증</h3>
      </div>
      <div class="cert-list">
        {certifications.map((cert) => (
          <div class="cert-item">
            <div class="cert-info">
              <h4 class="cert-name">{cert.name}</h4>
              <p class="cert-issuer">{cert.issuer}</p>
            </div>
            <span class="cert-date">{cert.date}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="cert-category">
      <div class="category-header">
        <div class="category-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8 6 6"></path><path d="m4 14 6-6 2-3"></path><path d="M2 5h12"></path><path d="M7 2h1"></path><path d="m22 22-5-10-5 10"></path><path d="M14 18h6"></path></svg>
        </div>
        <h3 class="category-title">어학</h3>
      </div>
      <div class="cert-list">
        {languages.map((lang) => (
          <div class="cert-item">
            <div class="cert-info">
              <h4 class="cert-name">{lang.name}</h4>
              <p class="cert-score">{lang.score}</p>
            </div>
            <span class="cert-date">{lang.date}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="section-bottom"> </div>
</section>

<style>
  .cert-section {
    background: var(--background-secondary);
    padding: 6rem 1.5rem;
    max-width: none;
  }

  .cert-section > * {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-top{
    margin-top: 8rem;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .cert-category {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .category-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: rgba(37, 99, 235, 0.1);
    border-radius: 12px;
    color: var(--primary);
  }

  .category-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .cert-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cert-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: var(--background-secondary);
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  .cert-item:hover {
    background: rgba(37, 99, 235, 0.05);
  }

  .cert-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--foreground);
    margin-bottom: 0.25rem;
  }

  .cert-issuer {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .cert-score {
    font-size: 0.875rem;
    color: var(--primary);
    font-weight: 600;
  }

  .cert-date {
    font-size: 0.8125rem;
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
  }
  .section-bottom{
    margin-bottom: 12rem;
  }
</style>
