---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { projects, getProjectBySlug } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug);

if (!project) {
  Astro.redirect('/404');
}
---

<Layout title={`${project.title} | 프로젝트`}>
  <Navigation />
  <main class="project-detail">
    <!-- 히어로 섹션 -->
    <section class="project-hero">
      <div class="hero-content">
        <a href="/#projects" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          프로젝트 목록으로
        </a>
        
        <div class="hero-header">
          <div class="project-badges">
            <span class="badge badge-period">{project.period}</span>
            <span class="badge badge-role">{project.role}</span>
            <span class="badge badge-team">{project.team}</span>
          </div>
          <h1 class="project-title">{project.title}</h1>
          <p class="project-subtitle">{project.fullDescription}</p>
        </div>

        <div class="tech-stack">
          {project.tech.map((tech) => (
            <span class="tech-tag">{tech}</span>
          ))}
        </div>

       {(project.links.github || project.links.demo) && (
          <div class="project-links">
            {project.links.demo && (
              <button
                type="button"
                class="link-btn link-demo"
                id="openDemoBtn"
                data-demo={project.links.demo}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" x2="21" y1="14" y2="3"/>
                </svg>
                Live Demo
              </button>
            )}
            {project.links.github && (
              <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="link-btn link-github">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                GitHub
              </a>
            )}
            {project.links.website && (
              <a href={project.links.website} target="_blank" rel="noopener noreferrer" class="link-btn link-website">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                Website
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- 이미지 갤러리 섹션 -->
    <section class="project-gallery">
      <div class="gallery-header">
        <span class="section-label">Gallery</span>
        <h2 class="section-title">프로젝트 스크린샷</h2>
      </div>
      
      <div class="gallery-grid">
        {project.images.map((image, index) => (
          <div class={`gallery-item ${index === 0 ? 'gallery-featured' : ''}`}>
            <img src={image} alt={`${project.title} 스크린샷 ${index + 1}`} />
            <div class="gallery-overlay">
              <span class="gallery-number">{String(index + 1).padStart(2, '0')}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 주요 기능 섹션 -->
    <section class="project-features">
      <div class="features-container">
        <div class="features-content">
          <span class="section-label">Features</span>
          <h2 class="section-title">주요 기능</h2>
          <ul class="features-list">
            {project.features.map((feature, index) => (
              <li class="feature-item">
                <span class="feature-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="feature-text">{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="challenges-content">
          <span class="section-label">Challenges</span>
          <h2 class="section-title">기술적 도전</h2>
          <ul class="challenges-list">
            {project.challenges.map((challenge) => (
              <li class="challenge-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                <span>{challenge}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 다른 프로젝트 섹션 -->
    <section class="other-projects">
      <div class="other-header">
        <span class="section-label">Other Projects</span>
        <h2 class="section-title">다른 프로젝트 보기</h2>
      </div>
      
      <div class="other-grid">
        {projects.filter(p => p.slug !== project.slug).slice(0, 2).map((otherProject) => (
          <a href={`/projects/${otherProject.slug}`} class="other-card">
            <div class="other-image">
              <img src={otherProject.thumbnail} alt={otherProject.title} />
            </div>
            <div class="other-content">
              <h3>{otherProject.title}</h3>
              <p>{otherProject.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="back-to-list">
        <a href="/#projects" class="back-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          전체 프로젝트 목록 보기
        </a>
      </div>
    </section>

    {project.links.demo && (
        <div id="demoModal" class="demo-modal hidden" aria-hidden="true">
          <div class="demo-backdrop" data-close="true"></div>

          <div class="demo-panel" role="dialog" aria-modal="true" aria-label="Live Demo Preview">
            <div class="demo-topbar">
              <span class="demo-title">Live Demo</span>

              <div class="demo-actions">
                <a class="demo-open-new" href={project.links.demo} target="_blank" rel="noopener noreferrer">
                  새 탭으로 열기
                </a>
                <button type="button" class="demo-close" aria-label="닫기">✕</button>
              </div>
            </div>

            <iframe
              id="demoFrame"
              title="Live Demo"
              src={project.links.demo}
              loading="lazy"
            ></iframe>
          </div>
        </div>
      )}


  </main>


    <script>
    const openBtn = document.getElementById("openDemoBtn");
    const modal = document.getElementById("demoModal");
    const frame = document.getElementById("demoFrame");
    const closeBtn = modal?.querySelector(".demo-close");
    const backdrop = modal?.querySelector(".demo-backdrop");

    function openModal(url) {
      if (!modal || !frame) return;
      frame.src = url;
      modal.classList.remove("hidden");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!modal || !frame) return;
      modal.classList.add("hidden");
      modal.setAttribute("aria-hidden", "true");
      frame.src = "";
      document.body.style.overflow = "";
    }

    openBtn?.addEventListener("click", (e) => {
      const url = openBtn.getAttribute("data-demo");
      if (url) openModal(url);
    });

    closeBtn?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });
  </script>
</Layout>

<style>
  .project-detail {
    padding-top: 80px;
  }

  /* 히어로 섹션 */
  .project-hero {
    padding: 4rem 1.5rem 5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--primary);
  }

  .hero-header {
    margin-bottom: 2rem;
  }

  .project-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.375rem 0.875rem;
    border-radius: 20px;
  }

  .badge-period {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary);
  }

  .badge-role {
    background: rgba(16, 185, 129, 0.1);
    color: var(--success);
  }

  .badge-team {
    background: rgba(245, 158, 11, 0.1);
    color: var(--warning);
  }

  .project-title {
    font-size: 3rem;
    font-weight: 800;
    color: var(--foreground);
    line-height: 1.2;
    margin-bottom: 1.25rem;
    letter-spacing: -1px;
  }

  .project-subtitle {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.8;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 2rem;
  }

  .tech-tag {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    background: var(--background-secondary);
    color: var(--foreground-secondary);
    border-radius: 8px;
    border: 1px solid var(--border);
    transition: all 0.2s ease;
  }

  .tech-tag:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.875rem 1.5rem;
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .link-github {
    background: var(--foreground);
    color: var(--background);
  }

  .link-github:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
  }

  .link-demo {
    background: var(--primary);
    color: white;
  }

  .link-demo:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
  }

  /* 갤러리 섹션 */
  .project-gallery {
    padding: 5rem 1.5rem;
    background: var(--background-secondary);
  }

  .gallery-header,
  .other-header {
    max-width: 1200px;
    margin: 0 auto 3rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .gallery-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .gallery-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16/10;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover {
    transform: scale(1.02);
  }

  .gallery-featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent 50%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1rem;
  }

  .gallery-number {
    font-size: 1.5rem;
    font-weight: 800;
    color: white;
    opacity: 0.8;
  }

  /* 기능 섹션 */
  .project-features {
    padding: 5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .feature-number {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--primary);
    min-width: 2rem;
  }

  .feature-text {
    font-size: 1rem;
    color: var(--foreground-secondary);
    line-height: 1.6;
  }

  .challenges-list {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }

  .challenge-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
    background: var(--background-secondary);
    border-radius: 12px;
    font-size: 1rem;
    color: var(--foreground-secondary);
    line-height: 1.6;
    transition: transform 0.2s ease;
  }

  .challenge-item:hover {
    transform: translateX(4px);
  }

  .challenge-item svg {
    flex-shrink: 0;
    color: var(--success);
    margin-top: 2px;
  }

  /* 다른 프로젝트 섹션 */
  .other-projects {
    padding: 5rem 1.5rem;
    background: var(--background-secondary);
  }

  .other-grid {
    max-width: 1200px;
    margin: 0 auto 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .other-card {
    display: flex;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .other-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    box-shadow: var(--shadow-lg);
  }

  .other-image {
    width: 200px;
    flex-shrink: 0;
  }

  .other-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .other-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .other-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--foreground);
    margin-bottom: 0.5rem;
  }

  .other-content p {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .back-to-list {
    text-align: center;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--primary);
    padding: 0.875rem 1.5rem;
    border: 2px solid var(--primary);
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .back-btn:hover {
    background: var(--primary);
    color: white;
  }

  /* 반응형 */
  @media (max-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery-featured {
      grid-column: span 2;
      grid-row: span 1;
    }

    .features-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .project-title {
      font-size: 2.25rem;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-featured {
      grid-column: span 1;
    }

    .other-grid {
      grid-template-columns: 1fr;
    }

    .other-card {
      flex-direction: column;
    }

    .other-image {
      width: 100%;
      height: 180px;
    }

    .project-links {
      flex-direction: column;
    }

    .link-btn {
      justify-content: center;
    }
  }


  /* 데모 모달 */
.demo-modal.hidden { display: none; }

.demo-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
}

.demo-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.65);
}

.demo-panel {
  position: relative;
  width: min(1100px, 92vw);
  height: min(680px, 80vh);
  margin: 8vh auto 0;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
}

.demo-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  border-bottom: 1px solid var(--border);
  background: var(--background-secondary);
}

.demo-title {
  font-weight: 700;
  color: var(--foreground);
}

.demo-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.demo-open-new {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--primary);
}

.demo-open-new:hover {
  text-decoration: underline;
}

.demo-close {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.7);
  cursor: pointer;
}

#demoFrame {
  width: 100%;
  height: 100%;
  border: 0;
  background: white;
}

/* 버튼이 a->button으로 바뀌니 기본 버튼 스타일 제거 */
.link-btn.link-demo {
  border: none;
  cursor: pointer;
}

.link-website {
  background: #059669;
  color: white;
}

.link-website:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(5, 150, 105, 0.3);
}

</style>
